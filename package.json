{
  "name": "academicvault",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "cap:add": "npx cap add android && node scripts/ensure-android-file-opener.mjs",
    "cap:sync": "npm run build && node scripts/setup-android.mjs && npx cap sync android && node scripts/ensure-android-file-opener.mjs",
    "cap:open": "npx cap open android",
    "typecheck": "tsc -b",
    "test:ocr": "node --test tests/ocr-quality.test.mjs",
    "cap:setup": "node scripts/setup-android.mjs && node scripts/ensure-android-file-opener.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.1",
    "@capawesome-team/capacitor-file-opener": "8.0.1",
    "@capawesome/capacitor-google-sign-in": "^0.1.3",
    "@supabase/supabase-js": "^2.57.4",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
