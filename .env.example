# Default testing mode. No academic/user data is uploaded to Supabase.
VITE_DATA_MODE=local

# Only used when VITE_DATA_MODE=supabase
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Google Drive web OAuth client (create a Web application OAuth client in Google Cloud)
VITE_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
# Must exactly match an authorized redirect URI in Google Cloud Console.
VITE_GOOGLE_REDIRECT_URL=http://localhost:5173/google-drive
